DATABASE_URL=mysql://rootsmus_test:Froggie19581953@rootsmusicreport.com:3306/rootsmus_database
HOST=0.0.0.0
PORT=8000

# Database Pooling Configuration
MAX_CONNECTIONS=20
MIN_CONNECTIONS=5
CONNECT_TIMEOUT=8
IDLE_TIMEOUT=8
MAX_LIFETIME=1800000

# Static File Serving
STATIC_FILE_MODE=proxy
STATIC_FILE_PROXY_BASE=https://www.rootsmusicreport.com/img
STATIC_FILE_URL_PREFIX=/media

# Thumbnail Settings
THUMBNAIL_CACHE_DIR=_cache
THUMBNAIL_QUALITY=85
THUMBNAIL_MAX_WIDTH=2000
THUMBNAIL_MAX_HEIGHT=2000

# Logging Configuration
RUST_LOG=backend=debug,tower_http=debug
